# Copy to .env, replace passwords/origins/model tag, then export before running.
HTTP_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://gallery:change-me@127.0.0.1:5432/gallery?sslmode=disable
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# For LAN append the exact browser origin, for example http://192.168.1.50:8080.
# Frontend is built separately; unset FRONTEND_DIST_DIR for API-only development.
FRONTEND_DIST_DIR=./data/frontend
# Explicit opt-out for local HTTP only. Default without this variable: true.
COOKIE_SECURE=false
# Validated before HTTP startup; see docs/WORLD_CONTENT.md. No fallback world.
WORLD_DIR=./content/world
WORLD_VERSION=gallery_c01_v2
PHOTO_DIR=./data/photos
OLLAMA_BASE_URL=http://127.0.0.1:11434
# A01: prepare configs/ollama/main.Modelfile (Qwen3 4B Q4_K_M, num_ctx=8192).
# Measured conditions/limits: docs/MODEL_BENCHMARK.md. No download/auto-fallback.
# Manual offline reserve: gallery-guide-reserve:a01 (configs/ollama/reserve.Modelfile).
OLLAMA_MODEL=gallery-guide-main:a01
LOG_LEVEL=info

# Keep the same Compose project when running from an offline-kit directory.
COMPOSE_PROJECT_NAME=backend

# Compose PostgreSQL. Keep these consistent with DATABASE_URL.
POSTGRES_USER=gallery
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gallery
POSTGRES_PORT=5432
# Set TEST_DATABASE_URL separately, pointing to a dedicated test database.
