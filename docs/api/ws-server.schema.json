  "$defs": {
    "Vector3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "Rotation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "yaw": {
          "type": "number",
          "minimum": -3.141592653589793,
          "exclusiveMaximum": 3.141592653589793
        },
        "pitch": {
          "type": "number",
          "minimum": -1.5707963267948966,
          "maximum": 1.5707963267948966
        }
      },
      "required": [
        "yaw",
        "pitch"
      ]
    },
    "User": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\x21-\\x7E]+$"
        },
        "username": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "avatar_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "id",
        "username",
        "display_name",
        "avatar_color"
      ]
    },
    "AuthResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": {
          "$ref": "#/$defs/User"
        }
      },
      "required": [
        "user"
      ]
    },
    "RegisterRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "type": "string",
          "description": "После Unicode White_Space trim: [A-Za-z0-9_]{3,32}; хранится и возвращается lowercase. Проверяет сервер."
        },
        "display_name": {
          "type": "string",
          "description": "1–32 Unicode-кодовые точки после Unicode White_Space trim. Проверяет сервер."
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "writeOnly": true,
          "description": "8–128 байт UTF-8; без trim/нормализации. Байтовый минимум проверяет сервер."
        }
      },
      "required": [
        "username",
        "display_name",
        "password"
      ]
    },
    "LoginRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "type": "string",
          "description": "После Unicode White_Space trim: [A-Za-z0-9_]{3,32}; хранится и возвращается lowercase. Проверяет сервер."
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "writeOnly": true,
          "description": "8–128 байт UTF-8; без trim/нормализации."
        }
      },
      "required": [
        "username",
        "password"
      ]
    },
    "PlayerState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "room_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\x21-\\x7E]+$"
        },
        "position": {
          "$ref": "#/$defs/Vector3",
          "description": "Y=0; точка пола"
        },
        "rotation": {
          "$ref": "#/$defs/Rotation"
        }
      },
      "required": [
        "room_id",
        "position",
        "rotation"
      ]
    },
    "MeResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": {
          "$ref": "#/$defs/User"
        },
        "player_state": {
          "$ref": "#/$defs/PlayerState"
        }
      },
      "required": [
        "user",
        "player_state"
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
