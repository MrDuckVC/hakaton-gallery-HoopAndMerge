          "anyOf": [
            {
              "$ref": "#/$defs/DialogMessage"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "AI_TIMEOUT",
                    "AI_UNAVAILABLE",
                    "SERVER_RESTARTED",
                    "CANCELLED",
                    "AI_OUTPUT_LIMIT"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "request_id",
        "guide_id",
        "exhibit_id",
        "status",
        "user_message",
        "assistant_message",
        "error"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "assistant_message": {
                "$ref": "#/$defs/DialogMessage"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "assistant_message": {
                "type": "null"
              },
              "error": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "AI_TIMEOUT",
                      "AI_UNAVAILABLE",
                      "SERVER_RESTARTED",
                      "CANCELLED",
                      "AI_OUTPUT_LIMIT"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "retryable": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "queued",
                  "running"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "assistant_message": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
