{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Структура событий. Условия состояний, trim, idempotency и корреляции см. contract.md.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "world.snapshot"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\x21-\\x7E]+$"
        },
        "server_time": {
          "type": "string",
          "format": "date-time"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol_version": {
              "const": 1
            },
            "world_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[\\x21-\\x7E]+$"
            },
            "self": {
              "$ref": "#/$defs/Player"
            },
            "players": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Player"
              }
            },
            "current_room": {
              "$ref": "#/$defs/RoomPackage"
            }
          },
          "required": [
            "protocol_version",
            "world_version",
            "self",
            "players",
            "current_room"
          ]
        }
      },
      "required": [
        "type",
        "event_id",
        "server_time",
        "payload"
      ]
    },
